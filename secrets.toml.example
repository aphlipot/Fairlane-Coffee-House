# Copy these into the Secrets box on Streamlit Community Cloud
# (App settings > Secrets). For local runs, save as .streamlit/secrets.toml.
# Never commit real secrets to GitHub.

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# Public URL of your deployed app, used in password reset emails.
APP_URL = "https://your-app-name.streamlit.app"

# Starting manager and staff logins. Change these before you deploy.
[admin]
username = "manager"
password = "change-me-Manager1"
email = "you@example.com"
full_name = "Café Manager"

[staff]
username = "barista"
password = "change-me-Barista1"
email = "barista@example.com"
full_name = "Barista"

# Optional: email for password reset links.
# Gmail: turn on 2-Step Verification, then create an App Password and use it here.
[smtp]
host = "smtp.gmail.com"
port = 587
username = "fairlanecoffeehouse@gmail.com"
password = "your-16-character-app-password"
sender = "Fairlane Coffee House <fairlanecoffeehouse@gmail.com>"
